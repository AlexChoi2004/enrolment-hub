{
  "name": "enrolment-hub-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "React and TypeScript islands for Enrolment Hub. The built files are committed to ../shared/static/dist so the Flask app runs without Node.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && vite build --mode board",
    "dev:board": "vite build --mode board --watch"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
